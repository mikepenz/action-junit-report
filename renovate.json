{
  "$schema": "https://docs.renovateapp.com/renovate-schema.json",
  "extends": [
    "local>mikepenz/convention"
  ],
  "minimumReleaseAge": "7 days",
  "vulnerabilityAlerts": {
    "minimumReleaseAge": "7 days"
  },
  "packageRules": [
    {
      "matchPackageNames": [
        "@types/node"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": true
    }
  ]
}
